[Unit]
Description=Towerlog (broadcast audio logger)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=towerlog
Group=towerlog
Environment=NODE_ENV=production
Environment=TOWERLOG_CONFIG=@CONF_DIR@/config.json
Environment=TOWERLOG_DATA=@DATA_DIR@
Environment=TOWERLOG_LOG_DIR=@LOG_DIR@
WorkingDirectory=@APP_DIR@
ExecStart=@NODE@ @APP_DIR@/dist/towerlog.mjs
# SIGHUP restarts every input (reconnects every feed) without dropping the web UI.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
# 78 = the config file is unreadable: restarting can't fix that (see the journal).
RestartPreventExitStatus=78
# Stop the ffmpeg children with the service.
KillMode=control-group
TimeoutStopSec=25
# Needed if the web UI or source port is moved below 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=@CONF_DIR@ @DATA_DIR@ @LOG_DIR@ -/mnt -/media -/srv

[Install]
WantedBy=multi-user.target
