{
  "name": "towerlog",
  "version": "2026.10.4",
  "private": true,
  "type": "module",
  "description": "Broadcast audio logger: records IP audio feeds in 15/30/60 minute chunks, logs upstream faults, alerts via SNMP, Zabbix and email.",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-server.mjs",
    "start": "node dist/towerlog.mjs",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/svelte": "^1.51.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "net-snmp": "^3.29.1",
    "nodemailer": "^10.0.14",
    "svelte": "^5.57.1",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@internationalized/date": "^3.12.4",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "shadcn-svelte": "^1.7.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
